# App
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Database (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qlearn

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Provider: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Vercel Sandbox
VERCEL_TOKEN=
VERCEL_TEAM_ID=
SANDBOX_BASE_NAME=qlearn-python-base
SANDBOX_TIMEOUT=30000

# Razorpay (use rzp_test_* for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
