# App
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Database (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qlearn

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Project JWT secret (Dashboard → Settings → API → JWT Settings) — verifies Supabase Auth tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — ChatLiteLLM model routing (LiteLLM model strings)
# Primary model is tried first; fallbacks are tried in order on any provider failure.
# Model string format examples:
#   OpenAI:      gpt-4o-mini
#   Anthropic:   anthropic/claude-haiku-4-5-20251001
#   Gemini:      gemini/gemini-2.0-flash-exp
#   Groq:        groq/llama3-8b-8192  |  groq/mixtral-8x7b-32768
#   OpenRouter:  openrouter/openai/gpt-4o  |  openrouter/anthropic/claude-3-haiku
#   Ollama:      ollama/llama3.2
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_FALLBACK_MODELS=["anthropic/claude-haiku-4-5-20251001","gemini/gemini-1.5-flash"]
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Set only the keys for the providers you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Vercel Sandbox
VERCEL_TOKEN=
VERCEL_TEAM_ID=
SANDBOX_BASE_NAME=qlearn-python-base
SANDBOX_TIMEOUT=30000

# Razorpay (use rzp_test_* for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
