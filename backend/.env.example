# App
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Database (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qlearn

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Project JWT secret (Dashboard → Settings → API → JWT Settings) — verifies Supabase Auth tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — ChatLiteLLM model routing (LiteLLM model strings)
# Primary model is tried first; fallbacks are tried in order on any provider failure.
# Free model options (no billing required):
#   Groq (free tier):       groq/llama-3.3-70b-versatile  |  groq/llama-3.1-8b-instant  |  groq/deepseek-r1-distill-llama-70b
#   Gemini (Flash is free): gemini/gemini-2.0-flash  |  gemini/gemini-3-flash-preview
#   OpenRouter (free):      openrouter/nvidia/nemotron-3-ultra-550b-a55b:free  (best quality)
#                           openrouter/poolside/laguna-s-2.1:free
#                           openrouter/nvidia/nemotron-3-super-120b-a12b:free
#                           openrouter/nvidia/nemotron-3.5-lightning:free  (fastest)
#                           openrouter/cohere/north-mini-code:free
#                           openrouter/nex-agi/nex-n2.5-pro:free
#                           (all :free models — 20 req/min, 1000/day with $10 credits)
# Paid model options:
#   OpenAI:      gpt-4o-mini  |  gpt-4o
#   Anthropic:   anthropic/claude-haiku-4-5-20251001
#   Ollama:      ollama/llama3.2
LLM_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODELS=["gemini/gemini-2.0-flash","openrouter/nvidia/nemotron-3-ultra-550b-a55b:free","openrouter/poolside/laguna-s-2.1:free"]
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
# Per-model RPM overrides (optional — empty means use built-in provider defaults)
# LLM_MODEL_RPM_LIMITS={"groq/llama-3.3-70b-versatile": 600}
LLM_MODEL_RPM_LIMITS={}

# Set only the keys for the providers you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Vercel Sandbox
VERCEL_TOKEN=
VERCEL_TEAM_ID=
SANDBOX_BASE_NAME=qlearn-python-base
SANDBOX_TIMEOUT=30000

# Razorpay (use rzp_test_* for development)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Rate limiting
RATE_LIMIT_PER_MINUTE=100
