# App
SECRET_KEY=change-me-to-a-random-32-char-string
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]

# Database (asyncpg dialect)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/qlearn

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
# Project JWT secret (Dashboard → Settings → API → JWT Settings) — verifies Supabase Auth tokens
SUPABASE_JWT_SECRET=your-jwt-secret

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM — ChatLiteLLM model routing (LiteLLM model strings)
# ModelRouter ranks every model in the pool by remaining RPM, RPD, TPM and TPD headroom
# for each request; the rest become ordered fallbacks. See docs/llm-model-router.md.
#
# Groq free tier (per model; limits are per organization, not per API key):
#   groq/openai/gpt-oss-120b    30 RPM  1,000/day  8,000 TPM  ← best quality
#   groq/openai/gpt-oss-20b     30 RPM  1,000/day  8,000 TPM  ← fastest
#   groq/qwen/qwen3.8-27b       30 RPM  1,000/day  8,000 TPM
#   TPM, not RPM, caps throughput: steady state ≈ 24,000 ÷ tokens per request, ~2–4 RPM
#   for worst-case tutor requests (5–12k tokens). Daily ceiling: 3,000 requests.
#   When all three are saturated there is no overflow provider: requests queue on the
#   soonest-ready Groq model and may return 429.
#
# Other providers can be added to the pool (set their API key below):
#   Gemini: gemini/<model>  |  OpenRouter: openrouter/<model>  |  OpenAI: gpt-4o-mini
#   Anthropic: anthropic/claude-haiku-4-5-20251001  |  Ollama: ollama/llama3.2
LLM_PRIMARY_MODEL=groq/openai/gpt-oss-120b
LLM_FALLBACK_MODELS=["groq/openai/gpt-oss-20b","groq/qwen/qwen3.8-27b"]
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
# Per-model limit overrides (optional) — any of rpm/rpd/tpm/tpd; omitted fields keep the
# built-in values. Use after a paid-tier upgrade, with the numbers from
# https://console.groq.com/settings/limits:
# LLM_MODEL_LIMITS={"groq/openai/gpt-oss-120b": {"rpm": 1000, "rpd": 500000, "tpm": 250000}}
LLM_MODEL_LIMITS={}

# Set only the keys for the providers you use
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Vercel Sandbox
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Set exactly one of the following to a Qiskit-ready runtime (snapshot preferred).
# Leaving both empty uses the SDK default image (dev only — qiskit won't be present).
SANDBOX_SNAPSHOT_ID=
SANDBOX_IMAGE=
SANDBOX_VCPUS=1
SANDBOX_MEMORY=512
SANDBOX_TIMEOUT=30000

# Rate limiting
RATE_LIMIT_PER_MINUTE=100

# Payload CMS — must match CMS_WEBHOOK_SECRET in cms/.env. Empty disables
# POST /api/v1/internal/content-refs (the CMS then cannot register lessons).
CMS_WEBHOOK_SECRET=
