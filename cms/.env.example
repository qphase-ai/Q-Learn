# Q-Learn CMS (Payload) — copy to cms/.env
# Reference: docs/Curriculum/cirrculum-store-architecture.md

# Same Supabase Postgres as the backend. Payload confines itself to the
# `payload` schema; use a role that cannot write `public` in production.
PAYLOAD_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qlearn
# Long random string — signs CMS admin sessions.
PAYLOAD_SECRET=
# Public origin of this app (absolute media URLs, admin links).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# FastAPI backend — the CMS registers published lessons in content_refs.
# CMS_WEBHOOK_SECRET must equal the backend's CMS_WEBHOOK_SECRET.
BACKEND_API_URL=http://localhost:8000
CMS_WEBHOOK_SECRET=

# Student app — called on publish to revalidate cached lesson content.
# REVALIDATE_SECRET must equal the frontend's REVALIDATE_SECRET.
STUDENT_APP_URL=http://localhost:3000
REVALIDATE_SECRET=

# Supabase Storage (S3-compatible) for media. Leave S3_BUCKET empty to store
# uploads on local disk (development only).
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
