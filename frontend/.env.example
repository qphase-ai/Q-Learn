NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Dev-only: set to 1 in .env.local to open every page without logging in.
# Ignored in production builds. Leave unset/0 for normal auth.
NEXT_PUBLIC_DEV_NO_AUTH=0

# Curriculum source: "legacy" (FastAPI /api/v1/courses, default) or "cms"
# (Payload, read server-side through /api/cms/*). Learner state stays on FastAPI.
NEXT_PUBLIC_CONTENT_SOURCE=legacy
# Server-only: Payload CMS origin, and the secret the CMS sends to /api/revalidate
# (must equal REVALIDATE_SECRET in cms/.env).
CMS_URL=http://localhost:3001
REVALIDATE_SECRET=

# Sentry (javascript-nextjs project) — error monitoring + tracing. Empty DSN
# disables the SDK entirely (the default; safe for local dev). The DSN is
# public by design (client bundles read it) but every other Sentry setting
# below stays server-only. See docs/observability.md.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
# Server-side runtime (falls back to the above if unset).
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
# Build-time only, for source map upload — set in CI/Vercel, never locally,
# never NEXT_PUBLIC_*.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
